# Copy to .env.local for local work; add the same names in Vercel › Project › Settings › Environment Variables.
# Both values are in Supabase › Project Settings › API. The anon key is safe in the browser: row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Set to true after turning on Google in Supabase › Authentication › Providers.
VITE_ENABLE_GOOGLE_LOGIN=false

# Only for `npm run restore` on your own computer. NEVER put this in Vercel or in the repository.
# SUPABASE_SERVICE_ROLE_KEY=
